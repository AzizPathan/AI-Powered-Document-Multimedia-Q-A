# ============================================
# RAILWAY BACKEND ENVIRONMENT VARIABLES
# ============================================
# Set these in Railway backend service → Variables tab

# Database (automatically set when PostgreSQL is linked)
DATABASE_URL=postgresql://user:password@host:port/database

# OpenAI API (REQUIRED)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# JWT Secret (REQUIRED - generate with: openssl rand -hex 32)
JWT_SECRET=your-secure-random-string-minimum-32-characters

# CORS Origins (REQUIRED - your Vercel frontend URLs)
BACKEND_CORS_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app

# Redis (OPTIONAL - for rate limiting)
REDIS_URL=redis://redis.railway.internal:6379/0

# Rate Limiting (OPTIONAL - default: 60)
RATE_LIMIT_PER_MINUTE=60

# Upload Directory (OPTIONAL - default: uploads)
UPLOAD_DIR=uploads


# ============================================
# VERCEL FRONTEND ENVIRONMENT VARIABLES
# ============================================
# Set these in Vercel project → Settings → Environment Variables

# Backend API URL (REQUIRED - your Railway backend URL)
VITE_API_BASE_URL=https://your-backend.railway.app


# ============================================
# QUICK SETUP STEPS
# ============================================
#
# 1. RAILWAY BACKEND:
#    - Create PostgreSQL database
#    - Deploy backend from GitHub
#    - Link database to backend (sets DATABASE_URL automatically)
#    - Add OPENAI_API_KEY, JWT_SECRET, BACKEND_CORS_ORIGINS
#    - Generate domain and copy the URL
#
# 2. VERCEL FRONTEND:
#    - Import project from GitHub
#    - Add VITE_API_BASE_URL with Railway backend URL
#    - Deploy
#
# 3. CONNECT:
#    - Update BACKEND_CORS_ORIGINS in Railway with Vercel URL
#    - Redeploy both services
#    - Test: https://your-app.vercel.app
#
# ============================================
